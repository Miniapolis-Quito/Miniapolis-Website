# Dependencias
node_modules/

# Base de datos y sus archivos auxiliares de SQLite
data/
*.db
*.db-wal
*.db-shm

# Configuración local: contiene secretos, nunca se versiona.
# Los archivos de ejemplo sí se versionan: no llevan valores reales.
.env
.env.*
!*.example

# Registros y temporales
*.log
npm-debug.log*
.DS_Store
coverage/

# Artefactos de comprobación de Apple Wallet. Incluyen claves de firma locales
# y nunca forman parte de la aplicación ni de una entrega.
.tmp-pass/
# Pases generados para probar a mano: llevan el nombre del cliente y, si el
# pack admite QR fijo, un código que sirve para entrar.
*.pkpass
# Estado local de las herramientas de navegador automatizado.
.playwright-cli/
output/
