# Configuración de ejemplo para desarrollo local.
# Cópiala a `.env` si solo quieres levantar el sistema en tu máquina.
# Los secretos de aquí NO sirven para producción.

NODE_ENV=development
PORT=3000

# En desarrollo, si no defines secretos se generan al vuelo (y las sesiones se
# pierden al reiniciar). Definirlos evita tener que volver a entrar cada vez.
ACCESS_TOKEN_SECRET=desarrollo-access-cambiame-por-uno-de-verdad-00
REFRESH_TOKEN_SECRET=desarrollo-refresh-cambiame-por-uno-de-verdad-0
QR_SECRET=desarrollo-qr-cambiame-por-uno-de-verdad-000000

MASTER_EMAIL=admin@racinghobbies.ec
MASTER_PASSWORD=Pista-RC-Master-2026

COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=debug
