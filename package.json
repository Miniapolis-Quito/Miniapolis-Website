{
  "name": "racing-hobbies-tickets",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de entradas con packs y QR para la pista de autos RC de Racing Hobbies Ecuador",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "create-master": "node scripts/create-master.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "test:e2e": "node tests/e2e/flujo-completo.mjs",
    "test:ui": "node tests/e2e/interfaz.mjs",
    "test:camara": "node tests/e2e/camara.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jsqr": "^1.4.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
