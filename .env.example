# ===========================================================================
# Miniápolis #3 — sistema de entradas
# Copia este archivo a `.env` y completa los valores antes de arrancar.
# ===========================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Secretos (OBLIGATORIOS en producción)
#
# Genera cada uno por separado con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Si cambias ACCESS_TOKEN_SECRET o REFRESH_TOKEN_SECRET, todas las sesiones
# abiertas se cierran. Si cambias QR_SECRET, todos los códigos QR emitidos
# dejan de ser válidos (los clientes simplemente verán uno nuevo al abrir la
# app, pero los pases impresos habrá que reimprimirlos).
#
# Cada uno distinto. En producción la aplicación se niega a arrancar con los
# valores de .env.development.example, con uno que diga "cambiame" o con el
# mismo secreto repetido en dos variables.
# ---------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
QR_SECRET=

# Clave del segundo factor: cifra los secretos TOTP guardados y firma los
# códigos de respaldo. Es OPCIONAL, pero conviene ponerla.
#
# Si la dejas vacía se deriva de ACCESS_TOKEN_SECRET, y entonces cambiar el
# secreto de acceso deja ilegibles los segundos factores de todo el mundo: cada
# persona tendría que volver a configurarlo (el sistema lo detecta y lo dice; no
# deja entrar sin segundo paso). Poniéndola aquí, los dos secretos se rotan por
# separado.
TWOFA_SECRET=

# ---------------------------------------------------------------------------
# Cuenta máster inicial
# Solo se usa la primera vez que arranca el sistema, cuando aún no existe
# ningún administrador. Si dejas MASTER_PASSWORD vacío, se genera una
# contraseña segura y se imprime una única vez en la consola.
# ---------------------------------------------------------------------------
MASTER_EMAIL=admin@racinghobbies.ec
MASTER_PASSWORD=
MASTER_NAME=Administración Miniápolis

# ---------------------------------------------------------------------------
# Marca y moneda
# ---------------------------------------------------------------------------
# El «#» va entre comillas: sin ellas, los cargadores de .env que admiten
# comentarios al final de línea se comerían el «#3» del nombre.
BRAND_NAME="Miniápolis #3"
BRAND_SHORT=Miniápolis
CURRENCY=USD
TZ_DISPLAY=America/Guayaquil

# Precios del catálogo, en centavos (2500 = $25,00)
PACK_5_PRICE_CENTS=2500
PACK_10_PRICE_CENTS=4500

# Si vendes otros packs, defínelos aquí en vez de usar las dos líneas de arriba:
# entradas por pack y precio en centavos, separados por comas. Lo que pongas
# aquí reemplaza al catálogo por defecto.
#   PACK_CATALOG=5:2500,10:4500,20:8000
PACK_CATALOG=

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DATABASE_FILE=./data/tickets.db

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Marca Secure en las cookies. Debe quedar activo si sirves por HTTPS.
# Con él, la cookie de sesión lleva el prefijo __Host- (nadie en la red ni en
# otro subdominio puede plantar una). Al actualizar desde una versión anterior,
# cada persona tiene que volver a entrar una vez.
COOKIE_SECURE=true

# Actívalo SOLO si el servidor está detrás de un proxy inverso de confianza
# (nginx, Caddy, Cloudflare). Debes indicar debajo la IP o red CIDR de ese
# proxy; la aplicación no aceptará X-Forwarded-For de ninguna otra conexión.
TRUST_PROXY=false
# Para Caddy/nginx en la misma máquina: 127.0.0.1,::1
# Para un proxy remoto, usa su IP o su red CIDR y bloquea el acceso directo a
# este puerto con el firewall.
TRUSTED_PROXY_IPS=

# Orígenes adicionales permitidos, separados por comas. Vacío = solo el propio.
CORS_ORIGINS=

# Permite que los clientes creen su cuenta desde la web.
# Ponlo en false si prefieres darlas de alta solo en recepción.
ALLOW_SELF_REGISTRATION=true

MIN_PASSWORD_LENGTH=10
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Verificación en dos pasos (TOTP)
#
# Los valores de fábrica son los que entienden todas las aplicaciones de
# autenticación; solo hace falta tocarlos en casos raros.
#
# Que el personal esté OBLIGADO a usarla no se decide aquí, sino desde el panel
# («Seguridad»): así se puede encender cuando el equipo ya la tenga configurada,
# sin reiniciar nada.
# ---------------------------------------------------------------------------
# Tramos de 30 segundos de tolerancia a cada lado. Sube a 2 solo si los
# teléfonos de la pista andan con el reloj desviado.
TWOFA_WINDOW=1
# Cuánto vale el paso intermedio entre la contraseña y el código (segundos).
TWOFA_CHALLENGE_TTL=300
# Códigos incorrectos que admite un mismo acceso antes de anularse.
TWOFA_MAX_ATTEMPTS=5
# Códigos de respaldo que se entregan al activarla.
TWOFA_RECOVERY_CODES=10

# Duración del token de acceso (segundos). Corto a propósito: es lo que tarda
# en dejar de servir un token robado.
ACCESS_TOKEN_TTL=900

# Cuánto dura la sesión sin volver a escribir la contraseña (segundos).
REFRESH_TOKEN_TTL=2592000

# ---------------------------------------------------------------------------
# Correo y recuperación de contraseña (opcional)
#
# Con correo configurado, la página de acceso ofrece "¿Olvidaste tu
# contraseña?" y cada cambio de contraseña se avisa por correo. Hace falta
# también PUBLIC_URL (más abajo), en HTTPS: es el dominio del enlace.
# Sin SMTP_HOST, la recuperación queda apagada.
#
# El mismo correo envía los avisos a clientes (comprobante de compra y
# recordatorios), que se encienden desde Administración → Avisos. Sin
# PUBLIC_URL esos correos salen sin enlace a la app ni enlace de baja.
# ---------------------------------------------------------------------------
SMTP_HOST=
# 587 con STARTTLS obligatorio, o 465 con TLS directo.
SMTP_PORT=587
SMTP_USER=
# Mejor en un archivo con permisos solo para el servicio que en esta variable.
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
MAIL_FROM=Miniápolis <entradas@racinghobbies.ec>
# Cuánto vale el enlace de recuperación, en segundos (entre 300 y 86400).
PASSWORD_RESET_TTL_SECONDS=1800

# Tamaño máximo del cuerpo de una petición, en bytes.
MAX_BODY_BYTES=65536

# ---------------------------------------------------------------------------
# Códigos QR y consumo de entradas
# ---------------------------------------------------------------------------
# Cuántos segundos vale un QR desde que se genera. Más corto es más seguro
# frente a capturas de pantalla; más largo tolera peor señal en la pista.
QR_TTL_SECONDS=120

# Cada cuánto la app del cliente pide un QR nuevo.
QR_REFRESH_SECONDS=30

# Segundos que deben pasar entre dos consumos del mismo pack. Evita que un
# doble escaneo accidental descuente dos entradas. Súbelo si en tu operación
# nadie entra dos veces seguidas; bájalo si un grupo comparte un mismo pack.
REDEEM_COOLDOWN_SECONDS=20

# Horas que puede esperar una lectura que el escáner guardó durante un corte
# de red. Sin señal, el puesto sigue leyendo y cada entrada se cobra sola al
# volver la conexión, con la hora en que se leyó. Pasado este plazo, la lectura
# ya no se acepta y administración la ve como entrada sin cobrar. Con 0 el modo
# se apaga: sin red, el escáner pide reintentar a mano.
OFFLINE_SCAN_MAX_HOURS=24

# ---------------------------------------------------------------------------
# Pases en la cartera del teléfono (opcional)
#
# El cliente guarda su pack en Apple Wallet o Google Wallet y ve ahí cuántas
# entradas le quedan; el número se actualiza solo cada vez que se descuenta una.
# Cada plataforma se enciende por su cuenta y solo si están todos sus datos:
# sin credenciales, la función queda apagada y no se ofrece en la app.
#
# Dirección pública del sistema. Hace falta para Apple: el pase lleva dentro la
# URL a la que el teléfono vuelve a pedir el saldo, y tiene que ser accesible
# desde fuera.
PUBLIC_URL=

# --- Apple Wallet ---------------------------------------------------------
# Se obtiene en la cuenta de desarrollador de Apple (de pago):
#   1. Identifiers → Pass Type IDs → crear "pass.tu.dominio.entradas".
#   2. Emitir su certificado y exportarlo. Desde el .p12 que da Keychain:
#        openssl pkcs12 -in pase.p12 -clcerts -nokeys -out pase-cert.pem
#        openssl pkcs12 -in pase.p12 -nocerts -nodes  -out pase-key.pem
#   3. Descargar el certificado intermedio de Apple (WWDR) en formato PEM.
# Las rutas son relativas a la carpeta del proyecto.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERTIFICATE=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSWORD=
APPLE_WWDR_CERTIFICATE=

# Aviso al teléfono cuando cambia el saldo (opcional pero recomendado: sin esto
# el pase se actualiza solo cuando el teléfono pregunta por su cuenta).
# Keys → crear una clave con "Apple Push Notifications service" y guardar el .p8.
APPLE_APNS_KEY_ID=
APPLE_APNS_KEY=

# --- Google Wallet --------------------------------------------------------
# Se obtiene en la consola de Google Pay & Wallet (gratuita):
#   1. Pedir un ID de emisor (Issuer ID).
#   2. Crear una cuenta de servicio en Google Cloud con la API de Wallet
#      Objects activada, y autorizarla en la consola de Wallet.
#   3. Descargar su clave JSON y usar de ahí el correo y la clave privada.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
GOOGLE_WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Registro
# ---------------------------------------------------------------------------
LOG_LEVEL=info
