# ===========================================================================
# Racing Hobbies Ecuador — sistema de entradas
# Copia este archivo a `.env` y completa los valores antes de arrancar.
# ===========================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Secretos (OBLIGATORIOS en producción)
#
# Genera cada uno por separado con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Si cambias ACCESS_TOKEN_SECRET o REFRESH_TOKEN_SECRET, todas las sesiones
# abiertas se cierran. Si cambias QR_SECRET, todos los códigos QR emitidos
# dejan de ser válidos (los clientes simplemente verán uno nuevo al abrir la
# app, pero los pases impresos habrá que reimprimirlos).
# ---------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
QR_SECRET=

# ---------------------------------------------------------------------------
# Cuenta máster inicial
# Solo se usa la primera vez que arranca el sistema, cuando aún no existe
# ningún administrador. Si dejas MASTER_PASSWORD vacío, se genera una
# contraseña segura y se imprime una única vez en la consola.
# ---------------------------------------------------------------------------
MASTER_EMAIL=admin@racinghobbies.ec
MASTER_PASSWORD=
MASTER_NAME=Administración Racing Hobbies

# ---------------------------------------------------------------------------
# Marca y moneda
# ---------------------------------------------------------------------------
BRAND_NAME=Racing Hobbies Ecuador
BRAND_SHORT=Racing Hobbies
CURRENCY=USD
TZ_DISPLAY=America/Guayaquil

# Precios del catálogo, en centavos (2500 = $25,00)
PACK_5_PRICE_CENTS=2500
PACK_10_PRICE_CENTS=4500

# Si vendes otros packs, defínelos aquí en vez de usar las dos líneas de arriba:
# entradas por pack y precio en centavos, separados por comas. Lo que pongas
# aquí reemplaza al catálogo por defecto.
#   PACK_CATALOG=5:2500,10:4500,20:8000
PACK_CATALOG=

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DATABASE_FILE=./data/tickets.db

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Marca Secure en las cookies. Debe quedar activo si sirves por HTTPS.
COOKIE_SECURE=true

# Actívalo SOLO si el servidor está detrás de un proxy inverso de confianza
# (nginx, Caddy, Cloudflare). Si lo activas sin proxy, cualquiera puede
# falsificar su dirección IP y saltarse los límites de intentos: por eso el
# ejemplo viene apagado, aunque en una instalación con HTTPS delante —que es lo
# normal— haya que ponerlo en true.
TRUST_PROXY=false

# Orígenes adicionales permitidos, separados por comas. Vacío = solo el propio.
CORS_ORIGINS=

# Permite que los clientes creen su cuenta desde la web.
# Ponlo en false si prefieres darlas de alta solo en recepción.
ALLOW_SELF_REGISTRATION=true

MIN_PASSWORD_LENGTH=10
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900

# Duración del token de acceso (segundos). Corto a propósito: es lo que tarda
# en dejar de servir un token robado.
ACCESS_TOKEN_TTL=900

# Cuánto dura la sesión sin volver a escribir la contraseña (segundos).
REFRESH_TOKEN_TTL=2592000

# Tamaño máximo del cuerpo de una petición, en bytes.
MAX_BODY_BYTES=65536

# ---------------------------------------------------------------------------
# Códigos QR y consumo de entradas
# ---------------------------------------------------------------------------
# Cuántos segundos vale un QR desde que se genera. Más corto es más seguro
# frente a capturas de pantalla; más largo tolera peor señal en la pista.
QR_TTL_SECONDS=120

# Cada cuánto la app del cliente pide un QR nuevo.
QR_REFRESH_SECONDS=30

# Segundos que deben pasar entre dos consumos del mismo pack. Evita que un
# doble escaneo accidental descuente dos entradas. Súbelo si en tu operación
# nadie entra dos veces seguidas; bájalo si un grupo comparte un mismo pack.
REDEEM_COOLDOWN_SECONDS=20

# ---------------------------------------------------------------------------
# Registro
# ---------------------------------------------------------------------------
LOG_LEVEL=info
